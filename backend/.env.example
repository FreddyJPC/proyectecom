# Plantilla de variables de entorno — copiar a .env y rellenar con valores reales.
# Este archivo SÍ se versiona; .env NO.

ROCKETFY_BASE_URL=https://rocket-e.com/api
ROCKETFY_API_TOKEN=
ROCKETFY_ACCOUNT_EMAIL=
# Token propio del webhook (Rocket no autentica sus llamadas). Generar con:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
ROCKETFY_WEBHOOK_TOKEN=

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Connection string directa a Postgres (Project Settings -> Database -> Connection string).
# Necesaria para aplicar migraciones SQL (DDL); SERVICE_KEY solo sirve para CRUD vía REST.
SUPABASE_DB_URL=
# Llave pública (anon/publishable, Project Settings -> API) -- verifica el
# login del frontend (Fase 2 - Etapa 1). NO es SUPABASE_SERVICE_KEY.
SUPABASE_ANON_KEY=

NOTIFICATIONS_API_URL=
NOTIFICATIONS_API_KEY=

FLASK_ENV=development
LOG_LEVEL=INFO

# Origen permitido para llamadas CORS desde el frontend (Next.js).
FRONTEND_ORIGIN=http://localhost:3000

# Fase 3 - Bot de WhatsApp (Victoria). WhatsApp Cloud API (Meta).
WHATSAPP_API_TOKEN=             # token de acceso temporal o permanente de la Cloud API de Meta
WHATSAPP_PHONE_NUMBER_ID=       # Phone Number ID del número registrado en la WABA
WHATSAPP_WABA_ID=               # WhatsApp Business Account ID
WHATSAPP_WEBHOOK_VERIFY_TOKEN=  # token propio para el handshake GET del webhook -- generar con secrets.token_urlsafe(32)

# Fase 3.2 - cerebro conversacional de Victoria, desacoplado del proveedor.
# Selecciona el adapter activo (ver src/integrations/llm/) -- agregar un
# proveedor nuevo es escribir su adapter y sumarlo acá, sin tocar el resto.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5

# Claude / Anthropic -- requerida (fail-fast en integrations/llm/factory.py)
# SOLO SI LLM_PROVIDER=anthropic. Conseguir en console.anthropic.com.
ANTHROPIC_API_KEY=

# Límites de seguridad del loop de herramientas de Victoria (ver
# routes/whatsapp/conversation_service.py)
BOT_MAX_TURNOS_HERRAMIENTAS=5
BOT_MAX_MENSAJES_HISTORIAL=40

# Telegram (notificación al dueño cuando el bot escala a atención personal)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
